{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Verified student account profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "rollNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "cr", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "fullName", "email", "createdAt"]
    },
    "chatMessage": {
      "title": "Chat Message",
      "description": "Real-time messages sent by authenticated batchmates across devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "rollNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "cr", "admin"] },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "channel": { "type": "string", "enum": ["batch", "academic", "casual"] }
      },
      "required": ["senderUid", "senderName", "text", "timestamp", "channel"]
    },
    "poll": {
      "title": "Poll",
      "description": "Batch voting poll created by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "description": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "createdTimestamp": { "type": "number" },
        "expiresTimestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdBy": { "type": "string" },
        "isTimed": { "type": "boolean" }
      },
      "required": ["question", "options", "createdTimestamp", "status"]
    },
    "pollVote": {
      "title": "Poll Vote",
      "description": "Single vote cast by an authenticated student on a poll",
      "type": "object",
      "properties": {
        "pollId": { "type": "string" },
        "uid": { "type": "string" },
        "voterName": { "type": "string" },
        "voterEmail": { "type": "string" },
        "voterRoll": { "type": "string" },
        "optionId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["pollId", "uid", "optionId", "timestamp"]
    },
    "notice": {
      "title": "Notice",
      "description": "Batch notice and announcement managed by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "isImportant": { "type": "boolean" },
        "createdTimestamp": { "type": "number" },
        "updatedTimestamp": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "content", "date", "createdTimestamp"]
    },
    "resource": {
      "title": "Resource",
      "description": "Study resource such as lecture slides or textbook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["lecture", "book"] },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "string" },
        "phase": { "type": "string" },
        "subject": { "type": "string" },
        "term": { "type": "string" },
        "card": { "type": "string" },
        "createdTimestamp": { "type": "number" },
        "updatedTimestamp": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "type", "fileUrl", "phase", "subject"]
    },
    "resourceFolder": {
      "title": "ResourceFolder",
      "description": "Folder or subject categorization under academic phase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phase": { "type": "string" },
        "subject": { "type": "string" },
        "term": { "type": "string" },
        "level": { "type": "string", "enum": ["subject", "term", "card"] },
        "description": { "type": "string" },
        "section": { "type": "string", "enum": ["lecture", "book", "all"] },
        "isDeleted": { "type": "boolean" },
        "createdTimestamp": { "type": "number" },
        "updatedTimestamp": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "phase"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "User profile document keyed by Auth UID"
    },
    "/chatMessages/{messageId}": {
      "schema": {
        "$ref": "#/entities/chatMessage"
      },
      "description": "Batch chat messages ordered by timestamp"
    },
    "/polls/{pollId}": {
      "schema": {
        "$ref": "#/entities/poll"
      },
      "description": "Batch polls created and managed by Admin"
    },
    "/polls/{pollId}/votes/{userId}": {
      "schema": {
        "$ref": "#/entities/pollVote"
      },
      "description": "Subcollection storing one vote per authenticated student"
    },
    "/notices/{noticeId}": {
      "schema": {
        "$ref": "#/entities/notice"
      },
      "description": "Batch announcements managed by Admin"
    },
    "/resources/{resourceId}": {
      "schema": {
        "$ref": "#/entities/resource"
      },
      "description": "Lectures and textbooks collection managed by Admin"
    },
    "/resourceFolders/{folderId}": {
      "schema": {
        "$ref": "#/entities/resourceFolder"
      },
      "description": "Folders and subjects created and managed by Admin"
    }
  }
}
