rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() == 'cadetsalman2034@gmail.com';
    }

    function isBanned() {
      return isAuthenticated() && exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Banned users collection
    match /bannedUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reported messages collection
    match /reportedMessages/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() && !isBanned();
    }

    // Chat messages collection
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() && !isBanned()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.senderName is string
                    && request.resource.data.senderName.size() > 0;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      allow update: if isAdmin();
    }

    // Polls collection:
    // Anyone can read polls
    // Only Admin can create, update (e.g. close poll), or delete polls
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Votes subcollection:
      // User can read votes (to see results / who voted if public)
      // User can only write to their own document keyed by their auth.uid (prevents multiple votes!)
      // Cannot vote if poll is closed
      match /votes/{userId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAdmin();
      }
    }

    // Notices collection:
    // Anyone can read notices
    // Only Admin can create, update, or delete notices
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Resources collection (Lectures and Textbooks):
    // Anyone can read and download
    // Only Admin can create, update, or delete resources
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Resource Folders collection (custom folders/subjects):
    // Anyone can read folders
    // Only Admin can create, update, or delete folders
    match /resourceFolders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Gallery Groups collection (Albums and photos):
    // Anyone can read albums and photos
    // Only Admin can create, update, or delete albums and photos
    match /galleryGroups/{groupId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
